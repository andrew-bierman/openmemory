FROM node:24.22.1-bookworm-slim AS node-runtime

FROM oven/bun:1.4.4

COPY --from=node-runtime /usr/local/bin/node /usr/local/bin/node

WORKDIR /workspace

ENV CI=true \
  NO_COLOR=1 \
  WRANGLER_SEND_METRICS=false

COPY . .

RUN bun install --frozen-lockfile

CMD ["bun", "run", "test:integration:local"]
