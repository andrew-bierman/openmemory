{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openmemory-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["MemoryGraph"]
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "MEMORY_GRAPHS",
        "class_name": "MemoryGraph"
      }
    ]
  },
  "ai": {
    "binding": "AI"
  },
  "vectorize": [
    {
      "binding": "MEMORY_VECTORS",
      "index_name": "openmemory-vectors"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEMORY_EXPORTS",
      "bucket_name": "openmemory-exports"
    }
  ],
  "vars": {
    "EMBEDDING_MODEL": "@cf/baai/bge-small-en-v1.5"
  }
}
