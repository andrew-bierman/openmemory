  "oauth": {
    "authorizationServerPath": "/.well-known/oauth-authorization-server/api/auth",
    "protectedResourcePath": "/.well-known/oauth-protected-resource/mcp",
    "scopes": ["openid", "profile", "memory:read", "memory:write"]
  },
  "serverPath": "/mcp"
}
