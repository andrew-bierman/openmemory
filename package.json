{
  "name": "openmemory",
  "private": true,
  "description": "Cloudflare-native open-source memory infrastructure for AI tools and MCP clients",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andrew-bierman/openmemory.git"
  },
  "bugs": {
    "url": "https://github.com/andrew-bierman/openmemory/issues"
  },
  "homepage": "https://github.com/andrew-bierman/openmemory#readme",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "dev:api": "bun run web:ensure-assets && bun run --cwd apps/api dev",
    "dev:web": "bun run --cwd apps/web dev",
    "build": "turbo run build && bun run web:shell",
    "build:web-shell": "bun run --cwd apps/web build && bun run web:shell",
    "deploy": "bun run --cwd apps/api deploy",
    "setup:cloudflare": "bash scripts/setup-cloudflare.sh",
    "setup:r2-lifecycle": "bash scripts/apply-r2-lifecycle.sh",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "bun run --cwd apps/api wrangler d1 migrations apply openmemory-auth --local --config wrangler.jsonc",
    "db:migrate:remote": "bun run --cwd apps/api wrangler d1 migrations apply openmemory-auth --remote --config wrangler.jsonc",
    "check": "bun run security:secrets && bun run security:secrets:self-test && biome check . && turbo run check-types test",
    "check-types": "turbo run check-types",
    "format": "biome check --write .",
    "security:secrets": "bun scripts/secret-scan.ts",
    "security:secrets:self-test": "bun scripts/secret-scan.ts --self-test",
    "web:ensure-assets": "bun scripts/ensure-web-assets.ts",
    "web:shell": "bun scripts/render-web-shell.ts",
    "test": "turbo run test",
    "test:benchmark:local": "OPENMEMORY_BENCHMARK_REPORT=.tmp/benchmark-reports/benchmark-local.jsonl bun run --cwd apps/api test:benchmark",
    "test:benchmark:live": "OPENMEMORY_BENCHMARK_REPORT=.tmp/benchmark-reports/live-production.jsonl bun run --cwd apps/api test:live:benchmark",
    "test:scale:local": "OPENMEMORY_BENCHMARK_REPORT=.tmp/benchmark-reports/scale-local.jsonl bun run --cwd apps/api test:scale",
    "benchmark:import": "bun scripts/import-memorybench-fixture.ts",
    "benchmark:trend": "bun scripts/benchmark-trend-report.ts",
    "benchmark:trend:self-test": "bun scripts/benchmark-trend-report.ts --self-test",
    "test:mcp:sdk": "bun run build:web-shell && bun scripts/mcp-sdk-smoke.ts",
    "test:integration:local": "bun run --cwd apps/api test:integration",
    "test:integration:docker": "docker compose -f docker-compose.test.yml run --build --rm local-wrangler-integration",
    "test:e2e:local": "bun run build:web-shell && playwright test -c playwright.local.config.ts",
    "test:e2e:ui": "OPENMEMORY_LIVE_E2E=true playwright test -c playwright.config.ts",
    "release:validate": "bun run format && bun run check && bun run build && bun run test:mcp:sdk && bun run test:integration:local && bun run test:e2e:local && bun run test:benchmark:local && bun run test:scale:local"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.6",
    "@playwright/test": "^1.57.0",
    "drizzle-kit": "^0.31.10",
    "turbo": "^2.9.16",
    "typescript": "^5.9.2",
    "vitest": "^4.1.8"
  },
  "catalog": {
    "@cloudflare/vitest-pool-workers": "^0.9.8",
    "@cloudflare/workers-types": "^4.20260601.0",
    "@elysia/eden": "^1.4.10",
    "@better-auth/drizzle-adapter": "1.6.14",
    "@better-auth/memory-adapter": "1.6.14",
    "@better-auth/oauth-provider": "^1.6.14",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/bun": "^1.2.17",
    "agents": "^0.14.4",
    "better-auth": "^1.6.14",
    "drizzle-orm": "^0.45.2",
    "elysia": "^1.4.0",
    "wrangler": "^4.21.2",
    "zod": "^3.25.76"
  },
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14"
  }
}
