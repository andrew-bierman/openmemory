{
  "name": "openmemory",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "dev:api": "bun run --cwd apps/api dev",
    "dev:web": "bun run --cwd apps/web dev",
    "build": "turbo run build",
    "deploy": "bun run --cwd apps/api deploy",
    "setup:cloudflare": "bash scripts/setup-cloudflare.sh",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "bun run --cwd apps/api wrangler d1 migrations apply openmemory-auth --local --config wrangler.jsonc",
    "db:migrate:remote": "bun run --cwd apps/api wrangler d1 migrations apply openmemory-auth --remote --config wrangler.jsonc",
    "check": "biome check . && turbo run check-types test",
    "check-types": "turbo run check-types",
    "format": "biome check --write .",
    "test": "turbo run test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.6",
    "drizzle-kit": "^0.31.10",
    "turbo": "^2.9.16",
    "typescript": "^5.9.2",
    "vitest": "^4.1.8"
  },
  "catalog": {
    "@cloudflare/vitest-pool-workers": "^0.9.8",
    "@cloudflare/workers-types": "^4.20260601.0",
    "@elysia/eden": "^1.4.10",
    "@better-auth/drizzle-adapter": "1.6.14",
    "@better-auth/memory-adapter": "1.6.14",
    "@better-auth/oauth-provider": "^1.6.14",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/bun": "^1.2.17",
    "agents": "^0.14.4",
    "better-auth": "^1.6.14",
    "drizzle-orm": "^0.45.2",
    "elysia": "^1.4.0",
    "wrangler": "^4.21.2",
    "zod": "^3.25.76"
  },
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14"
  }
}
