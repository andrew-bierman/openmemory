{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "check-types": {
      "dependsOn": ["^check-types"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^check-types"],
      "outputs": []
    },
    "build": {
      "dependsOn": ["^build", "check-types"],
      "outputs": ["dist/**", ".output/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "deploy": {
      "dependsOn": ["check-types", "test"],
      "outputs": []
    },
    "@openmemory/api#test": {
      "dependsOn": ["^check-types"],
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/auth-email/**",
        "$TURBO_ROOT$/scripts/staging-qualification.ts"
      ]
    },
    "@openmemory/api#check-types": {
      "dependsOn": ["^check-types"],
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/auth-email/**",
        "$TURBO_ROOT$/scripts/staging-qualification.ts"
      ]
    }
  }
}
